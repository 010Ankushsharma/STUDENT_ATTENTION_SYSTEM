# ============================================
# Environment Configuration
# Copy to .env and customize
# ============================================

# Camera
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Processing
PROCESS_WIDTH=640
TARGET_FPS=30
SKIP_FRAMES=0

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0

# Database
DB_PATH=attention_system.db
DB_WAL_MODE=true
DB_RETENTION_DAYS=90

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs

# Alerts
ALERT_SOUND=false
ALERT_VISUAL=true

# Performance
BATCH_SIZE=50
FLUSH_INTERVAL=3.0
LOG_EVERY_N_FRAMES=5

